# ---- Database (required for anything that touches project data) ----
# Postgres with the pgvector extension. docker-compose.yml provisions this.
DATABASE_URL=postgres://compass:compass@localhost:5432/compass

# ---- LLM (required only for the agent / RAG / narrative paths) ----
# The scorecard's rubric math never calls this — see IMPLEMENTATION_PLAN.md M4.
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1

# ---- Embeddings (local, via Ollama — same model family as V1) ----
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
# Must match the vector column width in src/db/schema.ts.
EMBEDDING_DIMENSIONS=768

# ---- Tracing ----
# Spans are written to Postgres and rendered at /admin/traces. No extra infra.
OTEL_SERVICE_NAME=migration-compass
OTEL_ENABLED=true
# /admin/traces is a demo surface, not an auth boundary — it is gated behind
# this flag so a public deployment can leave it off.
ADMIN_TRACES_ENABLED=true

# ---- Logging ----
LOG_LEVEL=info
