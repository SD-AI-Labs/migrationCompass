# Copy this file to .env (which is git-ignored) and fill in real values.
# NEVER commit the real .env file, and NEVER `export` these in your shell
# profile (~/.zshrc, ~/.bashrc, etc.) — that makes them persistently
# readable by any tool with terminal access (editors, AI coding assistants,
# other processes). Use ./run.sh instead, which scopes the key to only the
# single Gradle process being started.

DEEPSEEK_API_KEY=your_key_here
